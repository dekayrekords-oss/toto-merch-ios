# Copy to .env (never commit it) and fill in your PayPal SANDBOX app's credentials
# from developer.paypal.com > Apps & Credentials > Sandbox.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional. The address the customer's phone can reach after paying (an HTTPS tunnel
# or this Mac's Wi-Fi address, e.g. http://192.168.1.20:8787). Defaults to the host
# the till used.
PUBLIC_BASE_URL=

# Optional shared token. If set, enter the same value in the app's
# Merch table settings > "Backend token".
MERCH_APP_TOKEN=

PORT=8787
CURRENCY=USD
MAX_ORDER_CENTS=50000
